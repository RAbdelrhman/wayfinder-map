{
  "name": "wayfinder-map",
  "version": "0.1.0",
  "description": "Interactive map of a repo's wayfinder maps, with one-click ticket hand-off to T3 Code",
  "type": "module",
  "license": "MIT",
  "bin": {
    "wayfinder-map": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
