{
  "name": "wayfinder-map",
  "version": "0.2.22",
  "description": "Interactive map of a repo's wayfinder maps, with one-click ticket hand-off to T3 Code",
  "type": "module",
  "main": "dist/desktop.cjs",
  "license": "MIT",
  "bin": {
    "wayfinder-map": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/cli.js",
    "dist/ui",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/cli.js",
    "desktop": "node scripts/desktop.mjs",
    "icons": "node scripts/create-icons.mjs",
    "package:win": "node scripts/package-win.mjs",
    "smoke:win": "node scripts/smoke-win.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:canvas": "node --test prototypes/canvas/tools/check.test.mjs",
    "test:device-presentation": "node scripts/check-device-presentation.mjs",
    "test:tour-layout": "node --test scripts/check-tour-layout.mjs",
    "canvas:create": "node scripts/create-canvas.mjs",
    "canvas:poster": "node scripts/capture-canvas-poster.mjs",
    "capture:prototype-thumbnails": "node prototypes/canvas/tools/capture-thumbnails.mjs",
    "lint": "eslint src/ scripts/ mobile/src/ mobile/plugins/",
    "prepare": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@eslint-community/eslint-utils": "^4.10.1",
    "@eslint/js": "^9.39.5",
    "@types/estree": "^1.0.9",
    "@types/node": "^22.10.2",
    "acorn": "^8.19.0",
    "electron": "44.4.3",
    "electron-builder": "26.16.1",
    "electron-updater": "6.8.9",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "playwright-core": "^1.64.1",
    "sharp": "0.35.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RAbdelrhman/wayfinder-map.git"
  },
  "homepage": "https://github.com/RAbdelrhman/wayfinder-map#readme",
  "bugs": {
    "url": "https://github.com/RAbdelrhman/wayfinder-map/issues"
  },
  "keywords": [
    "wayfinder",
    "github-issues",
    "t3-code",
    "visualization",
    "cli"
  ],
  "author": "Ramon Abdelrhman"
}
