    <activity android:name=".Main" android:theme="@android:style/Theme.Material.NoActionBar" android:exported="true" android:configChanges="orientation|screenSize">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
