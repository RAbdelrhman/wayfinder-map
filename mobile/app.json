{
  "expo": {
    "name": "Wayfinder",
    "slug": "wayfinder",
    "version": "1.4.0",
    "scheme": "wayfinder",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abdelrhr.wayfinder",
      "associatedDomains": ["applinks:wayfinder-links-pearl.vercel.app"]
    },
    "android": {
      "versionCode": 12,
      "intentFilters": [{
        "action": "VIEW",
        "autoVerify": true,
        "category": ["BROWSABLE", "DEFAULT"],
        "data": [
          { "scheme": "https", "host": "wayfinder-links-pearl.vercel.app", "pathPrefix": "/open/repo/" },
          { "scheme": "https", "host": "wayfinder-links-pearl.vercel.app", "pathPrefix": "/open/map/" },
          { "scheme": "https", "host": "wayfinder-links-pearl.vercel.app", "pathPrefix": "/open/ticket/" },
          { "scheme": "https", "host": "wayfinder-links-pearl.vercel.app", "pathPrefix": "/open/prototype/" }
        ]
      }],
      "adaptiveIcon": {
        "backgroundColor": "#0d1117",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.abdelrhr.wayfinder"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      "./plugins/withSharedSources",
      ["expo-sharing", { "android": { "enabled": true, "singleShareMimeTypes": ["text/plain"] }, "ios": { "enabled": true, "activationRule": { "supportsText": true, "supportsWebURLWithMaxCount": 1 } } }]
    ]
  }
}
