# Copy to .env.local and fill in. The client ID is public; the device flow needs no client secret.
# See docs/mobile-sign-in.md for creating the GitHub OAuth app.
EXPO_PUBLIC_GITHUB_CLIENT_ID=
# Optional public map references, using the desktop follows.json format, scoped by login.
# No tokens or private map bodies belong in this value.
# EXPO_PUBLIC_FOLLOWED_MAPS={"your-login":{"owner/public-repo":[123]}}
